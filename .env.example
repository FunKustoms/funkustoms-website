# API Configuration
VITE_API_URL=http://localhost:3000/api
VITE_API_TIMEOUT=30000

# Authentication
VITE_JWT_SECRET=your-secret-key-here
VITE_SESSION_TIMEOUT=3600000

# Stripe Configuration (Payment Gateway)
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
VITE_STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Email Service (for invitations, order confirmations)
VITE_EMAIL_SERVICE_API_KEY=your_email_api_key_here
VITE_EMAIL_FROM=noreply@funkustoms.com

# Storage/CDN (for product images)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_name
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key
VITE_CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin Configuration
VITE_ADMIN_EMAIL=admin@funkustoms.com
VITE_SUPER_ADMIN_PASSWORD=admin123

# Feature Flags
VITE_ENABLE_GUEST_CHECKOUT=true
VITE_ENABLE_BLOG=true
VITE_ENABLE_CUSTOMIZER=true
VITE_MAINTENANCE_MODE=false

# Analytics
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_FACEBOOK_PIXEL_ID=your_fb_pixel_id

# Environment
VITE_APP_ENV=development
VITE_APP_NAME=Funkustoms
VITE_APP_URL=http://localhost:5174

# Database (if using direct connection)
VITE_DB_HOST=localhost
VITE_DB_PORT=5432
VITE_DB_NAME=funkustoms
VITE_DB_USER=postgres
VITE_DB_PASSWORD=your_db_password

# Social Media Links
VITE_INSTAGRAM_URL=https://instagram.com/funkustoms
VITE_FACEBOOK_URL=https://facebook.com/funkustoms
VITE_TWITTER_URL=https://twitter.com/funkustoms

# Support
VITE_SUPPORT_EMAIL=support@funkustoms.com
VITE_SUPPORT_PHONE=+1-xxx-xxx-xxxx
